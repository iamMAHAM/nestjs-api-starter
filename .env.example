# --- Runtime -----------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
LOG_LEVEL="debug"

# --- Database ----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# --- Better Auth -------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:4000"
# Comma-separated list of origins allowed to hold a session cookie
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# lax | strict | none — "none" only for a frontend on another site (HTTPS only)
AUTH_COOKIE_SAME_SITE="lax"

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS="http://localhost:3000"
API_PREFIX="v1"
# Reverse proxies in front of the API: false | hop count | IPs/CIDRs (comma-separated)
TRUST_PROXY="false"

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"
