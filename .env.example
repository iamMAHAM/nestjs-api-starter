# --- Runtime -----------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
LOG_LEVEL="debug"

# --- Database ----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexasmi?schema=public"

# --- Better Auth -------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:4000"
# Comma-separated list of origins allowed to hold a session cookie
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS="http://localhost:3000"
API_PREFIX="v1"

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"
