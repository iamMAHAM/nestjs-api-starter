{
	"name": "nestjs-api-starter",
	"version": "0.1.0",
	"description": "NestJS API starter — Better Auth, Prisma, Zod, i18n, Biome",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "nest start --watch --preserveWatchOutput",
		"build": "nest build",
		"start": "node dist/main.js",
		"check": "biome check .",
		"check:fix": "biome check . --write",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"auth:generate": "auth generate --config src/auth/auth.cli.ts --output prisma/schema.prisma",
		"i18n:gen-types": "tsx src/i18n/scripts/gen-types.ts",
		"i18n:check": "tsx src/i18n/scripts/check-parity.ts",
		"prepare": "lefthook install",
		"dev:debug": "nest start --debug --watch --preserveWatchOutput",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@nestjs/common": "^12.3.3",
		"@nestjs/config": "^12.1.0",
		"@nestjs/core": "^12.3.3",
		"@nestjs/platform-express": "^12.3.3",
		"@nestjs/swagger": "^12.1.0",
		"@nestjs/terminus": "^12.1.0",
		"@nestjs/throttler": "^6.7.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@thallesp/nestjs-better-auth": "^2.8.0",
		"better-auth": "^1.7.16",
		"dotenv": "^18.0.9",
		"helmet": "^8.3.0",
		"i18next": "^26.7.1",
		"nestjs-pino": "^5.3.1",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@nestjs/cli": "^12.0.11",
		"@nestjs/schematics": "^12.0.12",
		"@nestjs/testing": "^12.3.3",
		"@standard-schema/spec": "1.1.0",
		"@swc/core": "^1.16.21",
		"@types/express": "^5.0.6",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.1.0",
		"auth": "^1.7.16",
		"i18next-resources-for-ts": "^2.1.2",
		"lefthook": "^2.2.2",
		"pino-pretty": "^13.2.0",
		"prisma": "^7.10.1",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^5.1.0"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@prisma/engines",
		"@swc/core",
		"esbuild",
		"lefthook",
		"prisma"
	],
	"overrides": {
		"multer": "^2.5.0"
	}
}
